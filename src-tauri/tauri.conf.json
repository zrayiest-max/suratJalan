{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Surat Jalan",
    "version": "0.1.0",
    "identifier": "com.jimi.suratjalan",
    "build": {
        "frontendDist": "../tauri-dist",
        "devUrl": "http://127.0.0.1:8000",
        "beforeDevCommand": "php artisan serve --host=127.0.0.1 --port=8000",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Surat Jalan",
                "width": 800,
                "height": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "resources": ["resources/laravel/**/*", "binaries/**/*"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
